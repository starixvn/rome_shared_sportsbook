    <!--Out Parameters-->
    <!--Out Parameters-->
    <!--Because of in 2 SPs Acc_CustomerSelMEditCustomer(m2) and Acc_CustomerSelMAgentInfo(m3) return value m3 and m2 similar.
        In Edit PT: M2 is M3, M3 is L3
        In Add New: We need M3, A4, N3 value-->
    <!--l3-->
    <add Type="Out" RoleId="3" TargetRoleId="2" FormId="1" MappingTarget="L3" Pattern="max_{SportId}ma{IsLive}positiontaking_{BetTypeId}" >
      <SportTypeId Format="v{0}" OmitWhenDefault="1"></SportTypeId>
