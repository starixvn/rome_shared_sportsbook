<?xml version="1.0" encoding="utf-8" ?>
<BettingLimitMappingSection>
  <BettingLimitMapping>
    <!--Common Forms-->
    <!--in parameters-->
    <add Type="In" TargetRoleId="0" MappingTarget="MinBet" Pattern="minbet{SportId}" >
      <SportId Format="v{0}" OmitWhenDefault="1"></SportId>
    </add>
    <add Type="In" TargetRoleId="0" MappingTarget="MaxBet" Pattern="maxbet{SportId}" >
      <SportId Format="v{0}" OmitWhenDefault="1"></SportId>
    </add>
    <add Type="In" TargetRoleId="0" MappingTarget="MaxPerMatch" Pattern="maxpermatch{SportId}" >
      <SportId Format="v{0}" OmitWhenDefault="1"></SportId>
    </add>
    <add Type="In" TargetRoleId="0" MappingTarget="MaxPerBall" Pattern="maxperball{SportId}" >
      <SportId Format="v{0}" OmitWhenDefault="1"></SportId>
    </add>
    <!--out parameters-->
    <add Type="Out" TargetRoleId="0" MappingTarget="MinBet" Pattern="minbet{SportId}" >
      <SportId Format="v{0}" OmitWhenDefault="1"></SportId>
    </add>
    <add Type="Out" TargetRoleId="0" MappingTarget="MaxBet" Pattern="maxbet{SportId}" >
      <SportId Format="v{0}" OmitWhenDefault="1"></SportId>
    </add>
    <add Type="Out" TargetRoleId="0" MappingTarget="MaxPerMatch" Pattern="maxpermatch{SportId}" >
      <SportId Format="v{0}" OmitWhenDefault="1"></SportId>
    </add>
    <add Type="Out" TargetRoleId="0" MappingTarget="MaxPerBall" Pattern="maxperball{SportId}" >
      <SportId Format="v{0}" OmitWhenDefault="1"></SportId>
    </add>
    <add Type="Out" TargetRoleId="0" MappingTarget="MinBetMax" Pattern="minbet{SportId}_max" >
      <SportId Format="v{0}" OmitWhenDefault="1"></SportId>
    </add>
    <add Type="Out" TargetRoleId="0" MappingTarget="MaxBetMin" Pattern="maxbet{SportId}_min" >
      <SportId Format="v{0}" OmitWhenDefault="1"></SportId>
    </add>
    <add Type="Out" TargetRoleId="0" MappingTarget="MaxPerMatchMax" Pattern="maxpermatch{SportId}_max" >
      <SportId Format="v{0}" OmitWhenDefault="1"></SportId>
    </add>
    <add Type="Out" TargetRoleId="0" MappingTarget="MaxPerMatchMin" Pattern="maxpermatch{SportId}_min" >
      <SportId Format="v{0}" OmitWhenDefault="1"></SportId>
    </add>
    <add Type="Out" TargetRoleId="0" MappingTarget="MaxPerBallMax" Pattern="maxperball{SportId}_max" >
      <SportId Format="v{0}" OmitWhenDefault="1"></SportId>
    </add>
    <add Type="Out" TargetRoleId="0" MappingTarget="MaxPerBallMin" Pattern="maxperball{SportId}_min" >
      <SportId Format="v{0}" OmitWhenDefault="1"></SportId>
    </add>
    <!--Form Company Edit Super-->
    <!--in parameters-->
    <add Type="Out" TargetRoleId="4" MappingTarget="MinBet" Pattern="minbet{SportId}" >
      <SportId Format="v{0}" OmitWhenDefault="1"></SportId>
    </add>
    <add Type="Out" TargetRoleId="4" MappingTarget="MaxBet" Pattern="maxbet{SportId}" >
      <SportId Format="v{0}" OmitWhenDefault="1"></SportId>
    </add>
    <add Type="Out" TargetRoleId="4" MappingTarget="MaxPerMatch" Pattern="maxpermatch{SportId}" >
      <SportId Format="{0}" OmitWhenDefault="1"></SportId>
    </add>
    <add Type="Out" TargetRoleId="4" MappingTarget="MaxPerBall" Pattern="maxperball{SportId}" >
      <SportId Format="{0}" OmitWhenDefault="1"></SportId>
    </add>
    <add Type="Out" TargetRoleId="4" MappingTarget="MaxPerMatchMin" Pattern="maxpermatch{SportId}_min" >
      <SportId Format="{0}" OmitWhenDefault="1"></SportId>
    </add>
    <add Type="Out" TargetRoleId="4" MappingTarget="MaxPerBallMin" Pattern="maxperball{SportId}_min" >
      <SportId Format="{0}" OmitWhenDefault="1"></SportId>
    </add>
  </BettingLimitMapping>
</BettingLimitMappingSection>

